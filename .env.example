# ============================================
# materALL AI Studio 环境变量配置
# ============================================

# 火山方舟 API Key（必填）
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# 说明：也可以在平台前端"设置"中填写，前端传入的 Key 优先于此处配置
ARK_API_KEY=

# 服务端口（默认 3000）
PORT=3000

# ============================================
# 【共享托管模式】（可选，多人共用一把 Key 时推荐）
# 配置后访问者无需填写 Key 即可使用（Key 只在服务端，访问者看不到明文）
# ============================================

# Bilibili llmapi 网关 Key（识别/对话托管；OpenAI 兼容，personal- 开头）
BILI_API_KEY=

# 访问码（可选）：开启后所有 AI 请求需要输入访问码，部署者可用它控制谁能用
# 例如：ACCESS_CODE=xm8888
ACCESS_CODE=
